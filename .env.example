# 对外访问地址。先复制为 .env，再按实际主机修改。
PLATFORM_HOST=localhost
PLATFORM_PORT=10443
PLATFORM_BASE_URL=https://localhost:10443
TZ=Asia/Shanghai

# 仅供 pull.sh 使用，不改变 Compose 中的标准镜像引用。
GHCR_MIRROR=ghcr.1ms.run
IMAGE_PULL_PARALLEL=4

# 业务扩展（逗号分隔）。未配置时只启动基础栈。
# 可选：g2rain-agent、g2rain-knowledge、g2rain-department、g2rain-member、g2rain-cms
# 也可用 ./start.sh --business <名> 临时追加。
BUSINESS_EXTENSIONS=g2rain-agent,g2rain-knowledge

# 当前发布版的 Nacos 初始化数据使用以下本地开发凭据。
# 若要更换，须同时更新 Nacos 内各服务的数据源配置。
MYSQL_ROOT_PASSWORD=g2rain123456
MYSQL_DATABASE=g2rain
MYSQL_USER=g2rain
MYSQL_PASSWORD=g2rain123456
REDIS_PASSWORD=g2rain_redis_11050826
NACOS_DATABASE=nacos
NACOS_MYSQL_USER=nacos
NACOS_MYSQL_PASSWORD=g2rain_nacos
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=g2rain_nacos
NACOS_AUTH_TOKEN=VGhyZWVGb3J0eVR3b0J5dGVzU2VjcmV0S2V5Rm9yTmFjb3M=
NACOS_NAMESPACE=g2rain-test

MYSQL_PORT=3306
REDIS_PORT=6379
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
KAFKA_PORT=9092
NGINX_HTTPS_PORT=10443
GATEWAY_PORT=10001
IAM_PORT=10000

# 匿名客服入口码可在平台应用授权中创建；留空时不开放匿名入口。
CHAT_ANONYMOUS_ENTRY_KEY=

# 知识库与文档解析。
KNOWLEDGE_STORAGE_ROOT=/data/knowledge
DOCLING_BASE_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.29.0
DOCLING_IMAGE=g2rain-bootstrap/docling-serve-cpu:v1.29.0
DOCLING_PORT=5001
# HybridChunker tokenizer（all-MiniLM-L6-v2）HF cache；入口脚本会 chown 并在缺模型时预拉。
# 也可用独立目录：DOCLING_HF_CACHE=./data/docling-hf
DOCLING_HF_CACHE=/root/.cache/huggingface
# 业务进程离线只读；首次缺模型由入口以 root 临时在线下载（DOCLING_HF_PREFETCH=1）
DOCLING_HF_HUB_OFFLINE=1
DOCLING_TRANSFORMERS_OFFLINE=1
DOCLING_HF_ENDPOINT=https://hf-mirror.com
DOCLING_HF_PREFETCH=1


MILVUS_PORT=19530
# 业务账号 username:password。Milvus 启动时幂等创建该用户并授权知识库 collection；须含大小写/数字/特殊字符中至少三类。
# 用户已存在时不会改密。勿提交真实生产密码。
MILVUS_TOKEN=knowledge-service:Ks#ChangeMe1
MILVUS_BOOTSTRAP_TOKEN=root:Milvus
KNOWLEDGE_MILVUS_COLLECTION=g2rain_knowledge_chunks_qwen_4096_v1

